CREATE TABLE IF NOT EXISTS songs (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    bpm INTEGER NOT NULL DEFAULT 120,
    time_signature TEXT NOT NULL DEFAULT '4/4',
    instrument TEXT NOT NULL DEFAULT 'GUITAR',
    created_at INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0,
    synced_at INTEGER
);

CREATE TABLE IF NOT EXISTS tracks (
    id TEXT NOT NULL PRIMARY KEY,
    song_id TEXT NOT NULL,
    name TEXT NOT NULL,
    instrument TEXT NOT NULL,
    audio_file_path TEXT NOT NULL,
    volume REAL NOT NULL DEFAULT 1.0,
    is_muted INTEGER NOT NULL DEFAULT 0,
    is_solo INTEGER NOT NULL DEFAULT 0,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (song_id) REFERENCES songs(id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS practice_sessions (
    id TEXT NOT NULL PRIMARY KEY,
    song_id TEXT,
    track_id TEXT,
    instrument TEXT NOT NULL,
    duration_ms INTEGER NOT NULL DEFAULT 0,
    score REAL NOT NULL DEFAULT 0.0,
    criteria_scores TEXT NOT NULL DEFAULT '{}',
    notes TEXT NOT NULL DEFAULT '',
    recorded_at INTEGER NOT NULL DEFAULT 0,
    synced_at INTEGER
);

CREATE TABLE IF NOT EXISTS score_configs (
    instrument TEXT NOT NULL PRIMARY KEY,
    config_json TEXT NOT NULL
);

getAllSongs:
SELECT * FROM songs ORDER BY updated_at DESC;

getSongById:
SELECT * FROM songs WHERE id = ?;

insertSong:
INSERT OR REPLACE INTO songs VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateSong:
UPDATE songs SET title = ?, bpm = ?, time_signature = ?, instrument = ?, updated_at = ? WHERE id = ?;

deleteSong:
DELETE FROM songs WHERE id = ?;

getTracksBySongId:
SELECT * FROM tracks WHERE song_id = ? ORDER BY created_at ASC;

insertTrack:
INSERT OR REPLACE INTO tracks VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateTrack:
UPDATE tracks SET name = ?, volume = ?, is_muted = ?, is_solo = ?, duration_ms = ? WHERE id = ?;

deleteTrack:
DELETE FROM tracks WHERE id = ?;

getAllSessions:
SELECT * FROM practice_sessions ORDER BY recorded_at DESC LIMIT ?;

insertSession:
INSERT OR REPLACE INTO practice_sessions VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteSession:
DELETE FROM practice_sessions WHERE id = ?;

getTotalPracticeMs:
SELECT COALESCE(SUM(duration_ms), 0) FROM practice_sessions;

getScoreConfig:
SELECT config_json FROM score_configs WHERE instrument = ?;

upsertScoreConfig:
INSERT OR REPLACE INTO score_configs VALUES (?, ?);
