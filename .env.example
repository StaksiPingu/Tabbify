# Tabbify Environment Variables
# Copy this to .env and fill in your values

# Database
DB_PASSWORD=change_me_in_production

# JWT (generate a strong random secret, min 32 chars)
JWT_SECRET=change_this_to_a_very_long_random_secret_string_please

# Optional overrides
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# STORAGE_PATH=/data/recordings
